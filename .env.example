# Copy to .env at project root. Never commit real credentials.
# Blank DATABASE_URL uses backend/demo.db (SQLite) for local MVP.
# Teacher workspace schema v3 supports SQLite only. PostgreSQL rollout is deferred.
DATABASE_URL=
# New databases use first-run teacher setup. Enable public seed accounts only for isolated demos/tests.
# Existing data is never removed when this is false. Never expose demo accounts to the Internet.
SHUBAN_SEED_DEMO=false
# Use true only when serving over HTTPS; local HTTP needs false.
COOKIE_SECURE=false
# --- AI agent (module B: backend/app/ai) ---
# AGENT_MODE: auto = use the real model when credentials are present, otherwise demo;
#             demo = preset demo content only; live = use the model when configured, otherwise report demo.
# Never commit real keys: the app keeps working in demo mode with blank values.
AGENT_MODE=auto
# OpenAI-compatible Chat Completions endpoint, e.g. https://api.example.com/v1
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Optional: separate vision model for photo recognition; falls back to MODEL_NAME.
MODEL_VISION_NAME=
# Network timeout is clamped to 1-60 seconds; AI browser requests wait 90 seconds.
MODEL_TIMEOUT_SECONDS=30
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=900
# Course retrieval: number of knowledge chunks to cite, and minimum BM25 score.
AGENT_TOP_K=4
AGENT_MIN_SCORE=0
# --- 语音输入适配（B 模块第三阶段，2026-09-25）---
# 留空则复用 MODEL_* 凭据；能力探针用 voice_credential_source 如实标注来源（voice_env / model_env / none）。
# 未配置时 POST /api/agent/voice/transcribe 返回 503 并给出浏览器原生方案，绝不返回编造的转写结果。
VOICE_BASE_URL=
VOICE_API_KEY=
VOICE_MODEL=
# 语音网络超时限制 1–60 秒，默认 20。
VOICE_TIMEOUT_SECONDS=20

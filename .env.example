# Copy to .env at project root. Never commit real credentials.
# Blank DATABASE_URL uses backend/demo.db (SQLite) for local MVP.
# PostgreSQL format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Use true only when serving over HTTPS; local HTTP needs false.
COOKIE_SECURE=false
# --- AI agent (module B: backend/app/ai) ---
# AGENT_MODE: auto = use the real model when credentials are present, otherwise demo;
#             demo = preset demo content only; live = require the real model.
# Never commit real keys: the app keeps working in demo mode with blank values.
AGENT_MODE=auto
# OpenAI-compatible Chat Completions endpoint, e.g. https://api.example.com/v1
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Optional: separate vision model for photo recognition; falls back to MODEL_NAME.
MODEL_VISION_NAME=
MODEL_TIMEOUT_SECONDS=30
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=900
# Course retrieval: number of knowledge chunks to cite, and minimum BM25 score.
AGENT_TOP_K=4
AGENT_MIN_SCORE=0
